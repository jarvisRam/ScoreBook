{
  "consumer": {
    "name": "ScoreBookMobile"
  },
  "interactions": [
    {
      "description": "a request for backend health status",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/api/health"
      },
      "response": {
        "body": {
          "content": {
            "mode": "mock",
            "status": "ok",
            "timestamp": 1737000000000
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.mode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.timestamp": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ScoreBookBackend"
  }
}