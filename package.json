{
  "name": "scorebook-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ScoreBook - Cross-platform sports score application",
  "scripts": {
    "mobile": "cd mobile && npm start",
    "backend": "cd backend && npm run dev",
    "test": "npm run test:mobile && npm run test:backend",
    "test:e2e:mobile": "$HOME/.maestro/bin/maestro test .maestro/flow.yaml",
    "build:web": "cd mobile && npx expo export --platform web",
    "test:e2e:web:install": "playwright install --with-deps chromium",
    "test:e2e:web": "playwright test",
    "test:e2e:web:live": "TEST_TARGET=live playwright test",
    "test:e2e:web:integration": "TEST_TARGET=integration playwright test",
    "test:mobile": "cd mobile && npm test",
    "test:backend": "cd backend && npm test",
    "perf:be": "node performance/scripts/run.js be-mock",
    "perf:fe": "node performance/scripts/run.js fe-mock",
    "perf:smoke": "node performance/scripts/run.js hosted-smoke",
    "perf:baseline": "node performance/scripts/run.js",
    "perf:grafana:up": "docker compose -f performance/grafana/docker-compose.yml up -d",
    "perf:grafana:down": "docker compose -f performance/grafana/docker-compose.yml down",
    "test:contract:local": "cd mobile && npm run test:contract && cd ../backend && npm run test:contract:local",
    "lint": "npm run lint:mobile && npm run lint:backend",
    "lint:mobile": "cd mobile && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/ScoreBook.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "sports",
    "scores",
    "testing",
    "automation",
    "cross-platform"
  ],
  "author": "Sriram",
  "license": "MIT",
  "dependencies": {
    "expo": "^54.0.30",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
