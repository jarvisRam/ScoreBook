    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "Set the time range to 30 days to read baseline drift across the scheduled runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
