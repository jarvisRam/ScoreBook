{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ],
    "crons": [
        {
            "path": "/api/matches/regenerate",
            "schedule": "0 */12 * * *"
        }
    ]
}
