# Environment
NODE_ENV=development

# API Mode: mock | real | simulation
DATA_MODE=mock

# Database (required for simulation mode - Neon Postgres)
# DATABASE_URL=postgres://...

# Server Configuration
PORT=3000

# RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key_here

# API Hosts (RapidAPI)
RAPIDAPI_CRICKET_HOST=cricbuzz-cricket.p.rapidapi.com
RAPIDAPI_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
RAPIDAPI_NFL_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
RAPIDAPI_HOCKEY_HOST=api-hockey.p.rapidapi.com
RAPIDAPI_TENNIS_HOST=tennis-live-data.p.rapidapi.com

# Polling/Cache Settings
CACHE_TTL=60
